<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="false"
	>
	<testsuites>
		<testsuite name="soli-passport">
			<directory suffix=".php">tests/unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
